# Domínio canônico — fonte única de verdade (ver security-architecture.md §2)
NEXT_PUBLIC_SITE_URL=https://caaju.com.br

# Firebase — client (público por design)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Firebase Admin — server only. NUNCA prefixar com NEXT_PUBLIC_
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Agenda onde os eventos são criados e de onde vem o "ocupado".
GOOGLE_CALENDAR_ID=emanuel@caaju.com.br

# Agenda cujos eventos representam JANELAS ABERTAS para intro calls.
# Crie uma agenda secundária chamada "Office hours" e cole o ID dela aqui.
# Sem esta variável, o sistema cai no fallback de horário comercial.
GOOGLE_AVAILABILITY_CALENDAR_ID=

# Delegação em todo o domínio (Google Workspace).
# A service account age COMO este usuário. Sem isto ela é identidade
# externa e não escreve em agenda alguma.
GOOGLE_IMPERSONATE_SUBJECT=emanuel@caaju.com.br

# Webhooks n8n — fluxo PUSH assinado com HMAC.
# O n8n nunca recebe credencial do GCP; ele só consome payload assinado.
N8N_WEBHOOK_URL=
N8N_MAGIC_LINK_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Allowlist do painel /client. Separado por vírgula.
# O e-mail vem do session cookie já verificado pelo Firebase; isto apenas
# define quem, entre os autenticados, é administrador.
ADMIN_EMAILS=emanuel@caaju.com.br
