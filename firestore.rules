rules_version = '2';

// DENY-ALL POR DESIGN.
//
// Todo acesso legítimo passa pelo Admin SDK no servidor, que ignora estas
// regras. Isso garante que nenhum bug de client-side jamais exponha material
// de cliente sob NDA — nem por engano, nem por regressão.
//
// Se um dia for necessário leitura direta pelo client, abrir por coleção
// específica e NUNCA para `cases`, `leads` ou `accessLogs`.
//
// Ver docs/security-architecture.md §7.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
